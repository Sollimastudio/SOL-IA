# Configuracao publica do cliente Supabase. A anon key pode ir ao navegador;
# a protecao real e feita por autenticacao + RLS no banco.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# So habilite depois de aplicar a migracao segura e reivindicar os dados legados.
VITE_SECURE_MEMORY_ENABLED=false

# O endpoint da Vercel tambem aceita as variaveis VITE_* acima para validar a sessao.
# Estas aliases sem VITE sao opcionais e continuam do lado do servidor.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Sensor oficial read-only dos Supabase Health Advisors. Exclusivo do servidor.
# Use token de Management API com o menor escopo disponivel; nunca prefixe com VITE_.
SUPABASE_PROJECT_REF=
SUPABASE_MANAGEMENT_ACCESS_TOKEN=

# Vercel AI Gateway / modelos pagos.
# As flags abaixo sao FALSE por padrao: cadastrar candidatos nao autoriza gasto nem muda producao.
# OIDC do Vercel continua preferido; AI_GATEWAY_API_KEY e opcional.
AI_GATEWAY_API_KEY=
JARVIS_METERED_AI_ENABLED=false
JARVIS_GPT6_EXPERIMENT_ENABLED=false
JARVIS_GPT6_DEFAULT_MODEL=openai/gpt-6-luna
JARVIS_GPT6_COMPLEX_MODEL=openai/gpt-6-sol

# Segredos exclusivos do servidor. Nunca use o prefixo VITE_ nestas variaveis.
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_GRAPH_API_VERSION=
META_ALLOWED_USER_IDS=
# Reference-series workflow: isolated rollout; never enables new model spending.
JARVIS_REFERENCES_ENABLED=false
JARVIS_MEDIA_ADAPTER_URL=
JARVIS_MEDIA_ADAPTER_TOKEN=
JARVIS_LUCIDA_INGEST_URL=
JARVIS_LUCIDA_BRIDGE_SECRET=
JARVIS_LUCIDA_INSIGHTS_URL=
JARVIS_LUCIDA_INSIGHTS_SECRET=
# Separate local/self-hosted CPU worker (not Vite/Vercel build variables).
# HTTPS reverse proxy exposes /reference and /transcribe to the authenticated servers.
# JARVIS_MEDIA_PYTHON=/absolute/path/to/isolated-env/bin/python
# JARVIS_MEDIA_MODEL_DIR=/absolute/path/to/verified-asr-weights
# JARVIS_MEDIA_WORK_DIR=/absolute/path/to/private-temporary-work
# JARVIS_MEDIA_PORT=8793
# LUCIDA_TRANSCRIPTION_TOKEN=SEPARATE_SERVER_SECRET
