# Configuracao publica do cliente Supabase. A anon key pode ir ao navegador;
# a protecao real e feita por autenticacao + RLS no banco.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# So habilite depois de aplicar a migracao segura e reivindicar os dados legados.
VITE_SECURE_MEMORY_ENABLED=false

# O endpoint da Vercel tambem aceita as variaveis VITE_* acima para validar a sessao.
# Estas aliases sem VITE sao opcionais e continuam do lado do servidor.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Segredos exclusivos do servidor. Nunca use o prefixo VITE_ nestas variaveis.
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_GRAPH_API_VERSION=
META_ALLOWED_USER_IDS=
